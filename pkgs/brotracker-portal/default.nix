{
  description = "Nix Flake for BroTracker";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
  };

  outputs =
    { self, nixpkgs }:
    let
      system = "x86_64-linux";
      pkgs = nixpkgs.legacyPackages.${system};
      inherit (pkgs) lib;
      version = "0.1.16";
    in
    {
      packages.${system}.default = pkgs.stdenv.mkDerivation (finalAttrs: {
        pname = "brotracker";
        inherit version;

        src = pkgs.fetchurl {
          url = "https://brotracker-prod.blr1.digitaloceanspaces.com/portal/brotracker-portal_${version}_amd64.deb";
          hash = "sha256-Bz4S3LTwNqZqKzQqacW7Dscvrr+iINwH9juU/jzz2Wk=";
        };

        nativeBuildInputs = with pkgs; [
          dpkg
          autoPatchelfHook
          makeWrapper
          wrapGAppsHook3
          gobject-introspection
          copyDesktopItems
        ];

        buildInputs = with pkgs; [
          stdenv.cc.cc.lib
          cairo
          libX11
          libXcomposite
          libXdamage
          libXext
          libXfixes
          libXrandr
          mesa
          expat
          libxcb
          libxkbcommon
          alsa-lib
          vulkan-loader
          libGL
          nss
          nspr
          dbus
          atk
          at-spi2-atk
          at-spi2-core
          cups
          gtk3
          pango
          systemd
          glib
          gsettings-desktop-schemas
          gst_all_1.gstreamer
          gst_all_1.gst-plugins-base
          gst_all_1.gst-plugins-good
          pipewire
          python3Packages.pyopengl
        ];

        runtimeDependencies = with pkgs; [
          systemd
          vulkan-loader
          xdg-desktop-portal
          libGL
          libnotify
          libsecret
          libpulseaudio
          pipewire
        ];

        dontConfigure = true;
        dontBuild = true;
        dontStrip = true;

        # We build the wrapper ourselves in preFixup so we can pass the GApps args.
        dontWrapGApps = true;

        # Generated by copyDesktopItems -> $out/share/applications/brotracker-portal.desktop
        desktopItems = [
          (pkgs.makeDesktopItem {
            name = "brotracker-portal";
            desktopName = "BroTracker";
            exec = "brotracker %U";
            icon = "brotracker-portal";
            comment = "Desktop tracking and telemetry client for Brototype students and staff.";
            categories = [ "Utility" ];
            startupWMClass = "BroTracker";
            terminal = false;
          })
        ];

        unpackPhase = ''
          runHook preUnpack
          dpkg-deb -x "$src" .
          runHook postUnpack
        '';

        installPhase = ''
          runHook preInstall

          mkdir -p "$out/bin" "$out/opt" "$out/share"

          if [ -d opt ]; then
            cp -r opt/. "$out/opt/"
          fi

          if [ -d usr/share ]; then
            cp -r usr/share/. "$out/share/"
          fi

          # Remember which icon name the deb's own desktop file used, then drop
          # the deb's desktop files (ours is generated by makeDesktopItem).
          orig_icon=""
          if [ -d "$out/share/applications" ]; then
            orig_icon=$(grep -h '^Icon=' "$out"/share/applications/*.desktop 2>/dev/null | head -n 1 | cut -d= -f2 || true)
            rm -f "$out"/share/applications/*.desktop
          fi
          mkdir -p "$out/share/applications"

          # Make sure an icon named "brotracker-portal" exists.
          # 1) If the deb shipped icons under a different name, copy them over.
          if [ -n "$orig_icon" ] && [ "$orig_icon" != "brotracker-portal" ] && [ -d "$out/share/icons" ]; then
            while IFS= read -r f; do
              ext="''${f##*.}"
              cp -f "$f" "$(dirname "$f")/brotracker-portal.$ext"
            done < <(find "$out/share/icons" -type f -name "$orig_icon.*" || true)
          fi

          # 2) If still nothing, fall back to the largest PNG in the app bundle.
          have_icon=""
          if [ -d "$out/share/icons" ]; then
            have_icon=$(find "$out/share/icons" -type f -name 'brotracker-portal.*' -print -quit || true)
          fi

          if [ -z "$have_icon" ]; then
            icon_src=$(
              find "$out/opt" -type f -iname '*.png' \
                ! -path '*/*test*/*' \
                -printf '%s\t%p\n' 2>/dev/null |
                sort -rn |
                head -n 1 |
                cut -f2- || true
            )
            if [ -n "$icon_src" ]; then
              mkdir -p "$out/share/icons/hicolor/512x512/apps"
              cp -f "$icon_src" "$out/share/icons/hicolor/512x512/apps/brotracker-portal.png"
            fi
          fi

          runHook postInstall
        '';

        preFixup = ''
          BINARY_PATH=$(
            find "$out/opt" -type f -executable \
              ! -name '*.so*' \
              ! -name 'chrome-sandbox' \
              ! -name 'chrome_crashpad_handler' \
              -printf '%s\t%p\n' |
              sort -rn |
              head -n 1 |
              cut -f2-
          )

          if [ -z "$BINARY_PATH" ]; then
            echo "Error: Could not find the main executable under opt/"
            exit 1
          fi

          echo "Wrapping main binary: $BINARY_PATH"

          makeWrapper "$BINARY_PATH" "$out/bin/brotracker" \
            "''${gappsWrapperArgs[@]}" \
            --add-flags "\''${NIXOS_OZONE_WL:+\''${WAYLAND_DISPLAY:+--ozone-platform-hint=auto --enable-features=WaylandWindowDecorations}}" \
            --prefix LD_LIBRARY_PATH : "${lib.makeLibraryPath finalAttrs.runtimeDependencies}" \
            --prefix PATH : "${lib.makeBinPath [ pkgs.xdg-utils ]}"
        '';

        meta = {
          description = "BroTracker desktop application";
          platforms = [ "x86_64-linux" ];
          mainProgram = "brotracker";
          sourceProvenance = [ lib.sourceTypes.binaryNativeCode ];
        };
      });

      apps.${system}.default = {
        type = "app";
        program = lib.getExe self.packages.${system}.default;
      };
    };
}
